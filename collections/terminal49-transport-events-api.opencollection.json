        },
        {
          "info": {
            "name": "List raw events for a container (deprecated)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal49.com/v2/containers/:id/raw_events",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource identifier (UUID)."
              }
            ]
          },
          "docs": "List raw events for a container (deprecated)"
        },
        {
          "info": {
            "name": "List transport events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal49.com/v2/transport_events",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Page number for JSON:API pagination."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of records per page."
              }
            ]
          },
          "docs": "List transport events"
        }
      ]
    }
  ],
  "bundled": true
